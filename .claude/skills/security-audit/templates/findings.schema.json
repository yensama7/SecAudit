{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "auditor-findings",
  "type": "object",
  "required": ["run_id", "repository", "languages", "coverage", "findings"],
  "additionalProperties": true,
  "properties": {
    "run_id": { "type": "string" },
    "repository": {
      "type": "object",
      "required": ["root", "commit"],
      "properties": {
        "root": { "type": "string" },
        "commit": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "languages": { "type": "array", "items": { "type": "string" } },
    "frameworks": { "type": "array", "items": { "type": "string" } },
    "coverage": {
      "type": "object",
      "required": ["complete", "in_scope_files", "examined_files"],
      "properties": {
        "complete": { "type": "boolean" },
        "in_scope_files": { "type": "integer" },
        "examined_files": { "type": "integer" },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id", "title", "severity", "confidence", "locations",
          "root_cause", "reachability", "impact", "evidence",
          "remediation", "verification_status", "fingerprint"
        ],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "start_line", "end_line"],
              "properties": {
                "path": { "type": "string" },
                "start_line": { "type": "integer" },
                "end_line": { "type": "integer" }
              }
            }
          },
          "functions": { "type": "array", "items": { "type": "string" } },
          "root_cause": { "type": "string", "minLength": 20 },
          "reachability": { "type": "string", "minLength": 10 },
          "impact": { "type": "string", "minLength": 10 },
          "evidence": { "type": "string", "minLength": 20 },
          "trigger": { "type": "string" },
          "remediation": { "type": "string", "minLength": 10 },
          "verification_status": {
            "enum": ["verified", "needs_investigation"]
          },
          "fingerprint": {
            "type": "object",
            "required": ["language", "category"],
            "properties": {
              "language": { "type": "string" },
              "ecosystem": { "type": "string" },
              "category": { "type": "string" },
              "operation": { "type": "string" },
              "trust_boundary": { "type": "string" },
              "flow_shape": { "type": "string" },
              "preconditions": { "type": "string" },
              "impact": { "type": "string" }
            }
          }
        }
      }
    },
    "unresolved_questions": { "type": "array", "items": { "type": "string" } }
  }
}
